{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/server.mjs": {
      "includeFiles": "data/**"
    },
    "api/**/*.mjs": {
      "includeFiles": "data/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-calibration",
      "schedule": "0 7 * * *"
    }
  ]
}
